{
  "name": "petri-overnight-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overnight neuroevolution trainer that publishes arch-5 Petri strain books",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "train": "tsx src/cli.ts",
